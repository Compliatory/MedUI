Screen SystemEventMembers {
    layout: Vertical { spacing: 0px; padding: 0px; }
    CriticalButton {
        id: acknowledge;
        requirement: "REQ-ACK-001";
        width: 120px;
        height: 32px;
        label: t("STR-ACK");
        color: Theme.Colors.Title;
        on_press: NoOp;
    }
    CriticalButton {
        id: halt;
        requirement: "REQ-HALT-001";
        width: 120px;
        height: 32px;
        label: t("STR-HALT");
        color: Theme.Colors.Title;
        on_press: TriggerHalt;
    }
}
