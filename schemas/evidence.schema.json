{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Compliatory/MedUI/schemas/0.3/evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "obligations",
    "rows"
  ],
  "properties": {
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity"
      },
      "uniqueItems": true
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "outcome"
        ],
        "properties": {
          "identity": {
            "$ref": "#/$defs/identity"
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "unsupported",
              "not-run",
              "missing-baseline"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "producer",
        "profile",
        "artifact",
        "assets",
        "screen",
        "node",
        "locale",
        "scenario",
        "capture",
        "frame",
        "check",
        "backend",
        "configuration"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "source"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "const": "MEDUI-PROFILE-RENDERED"
            },
            "version": {
              "const": 1
            }
          }
        },
        "artifact": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "description": "Unique logical artifact IDs in strictly ascending ASCII order; ordering and ID uniqueness are semantic identity constraints.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9./_-]*$"
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "screen": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scenario": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "const": "static"
            }
          ]
        },
        "capture": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "enum": [
                "extent-equality",
                "ink-containment",
                "tint-composition",
                "rgba8-sha256"
              ]
            },
            "version": {
              "const": 1
            }
          }
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "description": "Exact case-sensitive producer-scoped backend identifier. No alias canonicalization is applied."
        },
        "configuration": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Opaque producer-scoped token; payload and encoding are defined by the producer contract, not by MedUI."
        }
      }
    }
  }
}
